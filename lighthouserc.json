{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/book",
        "http://localhost:4173/pricing",
        "http://localhost:4173/work",
        "http://localhost:4173/faq"
      ],
      "startServerCommand": "npx serve dist -l 4173 -L",
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 30720 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 1500 }]
      }
    }
  }
}
