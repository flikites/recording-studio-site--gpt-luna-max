---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
const groups = [
  { name: 'Microphones', items: [['AT4047 (the workhorse)', 'vocal chain lead'], ['Neumann TLM 103', 'detail / air vocals'], ['Shure SM7B', 'aggressive rap vocals'], ['Shure SM57', 'amps & percussion'], ['AKG C414', 'group vocals & overheads']] },
  { name: 'Preamps & Outboard', items: [['UA 1176LN pair', 'fast comp, the rap chain'], ['Teletronix LA-2A', 'warm leveling'], ['Pultec EQP-1A style', 'top & low shelf'], ['Neve 1073-style pre', 'color + gain'], ['dbx 160A', 'parallel glue']] },
  { name: 'Monitoring & Room', items: [['KRK Rokit 8 G4 + 10S subs', 'the room standard'], ['Yamaha HS8s', 'translation check'], ['Focal clear-style reference', 'midrange truth'], ['Auralex foam + bass traps', 'booth tuned 200–400Hz'], ['Acoustic Cloud ceiling', 'first reflection kill']] },
  { name: 'Computers & Software', items: [['Pro Tools Studio · Ableton Live Suite · Logic Pro', 'your tempo, your world'], ['2× M2 Max MacBook Pro rigs', 'zero session lag'], ['Apogee Symphony + HDX', 'clocked, quiet'], ['Antares Auto-Tune · Melodyne', 'natural, not robotic'], ['Slate Trigger · SPL Transient Designer', 'drums that knock']] },
  { name: 'The Extras', items: [['50″ 4K client display + Spotify/Apple referenceing', 'play your references loud'], ['Couch that fits 6 (respectfully)', 'yeah it’s real leather'], ['Espresso · cold brew · sparkling water', 'fuel included'], ['Free parking behind the building', 'buzzer #7, north door'], ['Ozone machine + air purifier', 'the room smells like money, literally']] },
];
---
<BaseLayout
  title="The Studio & Gear | The Signal Room — Pompano Beach"
  description="Vocal booth, 44-channel console, AT4047/TLM103 chains, 1176 + LA-2A outboard, Pro Tools/Ableton/Logic. See the room, the gear list and how to find us."
  path="/studio"
>
  <section class="section" style="padding-top:110px">
    <div class="container">
      <p class="kicker mono accent">The Studio</p>
      <h1 class="display" style="font-size:clamp(2.6rem,7vw,5rem)">The room<br/><span class="accent">does the talking.</span></h1>
      <p class="hero-sub mt-16" style="max-width:56ch">Low light, warm wood, real outboard. Built for rap records — fast sessions, honest levels, files in your hand before you leave.</p>

      <div class="split mt-32">
        <div class="gallery" style="grid-auto-columns:88%" aria-label="Studio walkthrough photos">
          <figure><picture><source srcset="/img/room-booth-1280.avif" type="image/avif"/><img src="/img/room-booth-1280.jpg" alt="The booth — condenser mic, foam and lime lighting strip" width="1280" height="1600" loading="lazy" decoding="async" style="height:440px"/></picture><figcaption><span>The Booth</span><span>Isolation + character</span></figcaption></figure>
          <figure><picture><source srcset="/img/room-console-1280.avif" type="image/avif"/><img src="/img/room-console-1280.jpg" alt="Console with outboard compressors and nearfield monitors" width="1280" height="853" loading="lazy" decoding="async" style="height:440px"/></picture><figcaption><span>The Console</span><span>44ch · outboard chain</span></figcaption></figure>
          <figure><picture><source srcset="/img/room-hands-1280.avif" type="image/avif"/><img src="/img/room-hands-1280.jpg" alt="Close-up of engineer riding the fader" width="1280" height="853" loading="lazy" decoding="async" style="height:440px"/></picture><figcaption><span>The Chain</span><span>1176 · LA-2A · Pultec</span></figcaption></figure>
          <figure><picture><source srcset="/img/room-lounge-1280.avif" type="image/avif"/><img src="/img/room-lounge-1280.jpg" alt="Lounge with leather couch, vinyl and neon" width="1280" height="853" loading="lazy" decoding="async" style="height:440px"/></picture><figcaption><span>The Lounge</span><span>Crew corner</span></figcaption></figure>
        </div>
        <div>
          <p class="kicker mono accent">Field notes</p>
          <ul class="price-list" style="gap:14px; font-size:15px">
            <li>Booth tuned for vocals in 200–400 Hz build-up — chest-forward, not boxy</li>
            <li>Instant recall: every vocal chain patch saved per session, reload in seconds</li>
            <li>Dual headphone systems + talkback, so hooks go down fast</li>
            <li>Late nights run 10AM–2AM. Buzzer #7, north door, follow the lime light</li>
            <li>Free parking directly behind the building — load in through the back</li>
          </ul>
          <a class="btn btn-accent mt-24" href="/book" data-track="cta_click" data-location="studio-page">Book the room <span class="arrow">→</span></a>
        </div>
      </div>

      <h2 class="display mt-40" style="font-size:clamp(1.8rem,4vw,3rem)">Gear list</h2>
      <div class="gear-group mt-16">
        {groups.map((g, i) => (
          <details open={i === 0}>
            <summary>{g.name}<span class="plus" aria-hidden="true" style="color:var(--accent); font-family:var(--font-mono)">+</span></summary>
            <ul>{g.items.map(([a, b]) => <li><b>{a}</b><br/><span class="mono" style="font-size:10px">{b}</span></li>)}</ul>
          </details>
        ))}
      </div>

      <h2 class="display mt-40" style="font-size:clamp(1.8rem,4vw,3rem)">Find us</h2>
      <div class="grid-2 mt-16" style="align-items:stretch">
        <a class="panel" href={SITE.mapsLink} rel="noopener" style="text-decoration:none; display:flex; flex-direction:column; gap:10px" aria-label="Open directions in Google Maps">
          <span class="mono accent">MAP →</span>
          <b style="font-size:19px">{SITE.address}</b>
          <span class="text-dim">Free parking behind the building · buzzer #7 · north door. Tap to open in Google Maps.</span>
        </a>
        <div class="panel">
          <span class="mono accent">HOURS</span>
          <p class="mt-8" style="font-weight:700">{SITE.hours}</p>
          <p class="text-dim mt-8" style="font-size:14px">Walk-ins when the room’s open — but weekends fill by Thursday. <a href="/book" style="color:var(--accent)">Book ahead →</a></p>
          <p class="mono mt-16" style="font-size:11px">Buzzer #7 · Parking: free · 10 min from I-95 via Atlantic Blvd</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
