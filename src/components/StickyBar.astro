---
import { SITE } from '../data/site';
const path = Astro.url.pathname;
const hide = path === '/book' || path.startsWith('/book/') || path.startsWith('/lp/');
---
{!hide && (
  <div class="sticky-bar" id="stickyBar" aria-hidden="true">
    <a class="btn btn-accent" href="/book">Book Session <span class="arrow">→</span></a>
    <a class="btn btn-ghost sms" href={SITE.smsHref} aria-label={`Text us at ${SITE.phone}`}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 6 8.38 8.38 0 0 1-3.8-.9L3 21l1.6-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 6-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      Text
    </a>
  </div>
)}
